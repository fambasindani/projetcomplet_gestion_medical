# ============================================================================
#  GS-Hopital - Application React servie par Apache sous /med
#
#  Ce fichier doit se trouver dans le dossier web de l'application
#  (le contenu de frontend-vite/dist), par exemple :
#      C:\Apache24\htdocs\med\.htaccess
#  ou  /var/www/html/med/.htaccess
#
#  Prerequis Apache : AllowOverride All sur le dossier (httpd.conf) et
#  le module mod_rewrite active.
# ============================================================================

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # L'application est servie sous /med/
    RewriteBase /med/

    # 1. Les fichiers et dossiers existants sont servis tels quels
    #    (assets JS/CSS, Logo.png, favicon...)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. L'API n'est pas dans ce dossier : ne pas la reecrire
    #    (elle est proxifiee vers le backend sur le port 7035)
    RewriteRule ^api/ - [L]

    # 3. Toute autre URL est une route React (BrowserRouter) :
    #    on renvoie index.html et le routeur prend le relais.
    RewriteRule ^ index.html [L]
</IfModule>

# Fallback pour Apache sans mod_rewrite (2.2.16+ / 2.4)
<IfModule !mod_rewrite.c>
    FallbackResource /med/index.html
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache -------------------------------------------------------------------
# Les fichiers de /assets/ ont un nom avec empreinte : cache long.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresDefault "access plus 1 hour"
</IfModule>

# index.html ne doit pas etre mis en cache (mises a jour immediates)
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
